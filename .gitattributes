# 默认自动识别文本，仓库内统一 LF（Android/Gradle 工程要求）
* text=auto

# Kotlin / Gradle / 配置全部 LF
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.pro       text eol=lf
*.properties text eol=lf
gradlew     text eol=lf
*.sh        text eol=lf

# Windows 批处理必须 CRLF，否则命令解析异常
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件不做行尾转换
*.jar       binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.docx      binary
