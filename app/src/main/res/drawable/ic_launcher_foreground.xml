<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：化学分解感的关系图（中心原子 + 三条键 + 三个外围原子 + 虚线轨道）。
  与 GuangXIW 的图标同源但不同构图：那边是三个节点连成三角，这边强调「中心 + 分解」。
  画布 108x108，安全区中央 72x72（18~90）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 外圈虚线轨道 -->
    <path
        android:pathData="M54,20 a34,34 0 1,0 0.01,0"
        android:strokeWidth="1.6"
        android:strokeColor="#5B7CD8"
        android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- 三条键 -->
    <g>
        <path android:pathData="M54,54 L54,32" android:strokeWidth="3.2"
            android:strokeColor="#4C6FE0" android:fillColor="#00000000" />
        <path android:pathData="M54,54 L73,65" android:strokeWidth="3.2"
            android:strokeColor="#5B7CD8" android:fillColor="#00000000" />
        <path android:pathData="M54,54 L35,65" android:strokeWidth="3.2"
            android:strokeColor="#6A78E8" android:fillColor="#00000000" />
    </g>

    <!-- 外围原子 -->
    <path android:pathData="M54,25 a7,7 0 1,0 0.01,0" android:fillColor="#7FD4F0" />
    <path android:pathData="M76,67 a7,7 0 1,0 0.01,0" android:fillColor="#9A9BF0" />
    <path android:pathData="M32,67 a7,7 0 1,0 0.01,0" android:fillColor="#6AB8E8" />

    <!-- 中心原子：渐变实心圆 -->
    <path android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="41" android:startY="41"
                android:endX="67" android:endY="67">
                <item android:offset="0.0" android:color="#3BA0FF" />
                <item android:offset="1.0" android:color="#8F7CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心高光，避免整块死板 -->
    <path android:pathData="M54,54 m-6,-4 a7,6 0 1,0 12,0 a7,6 0 1,0 -12,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.22" />
</vector>