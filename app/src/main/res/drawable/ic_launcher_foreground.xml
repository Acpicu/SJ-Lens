<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应启动图标前景层：单个字母 S，居中，蓝青线性渐变。
  背景为深灰蓝，见 res/values/colors.xml 的 ic_launcher_background。
  画布 108x108，安全区为中心 72x72（18 至 90），字形收在安全区内。
  minSdk 26，矢量图渐变在 API 24 起支持，可以放心用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M66,42 C66,36 60,33 54,33 C47,33 42,37 42,43 C42,49 48,51 54,53 C60,55 66,57 66,63 C66,69 60,73 54,73 C47,73 41,70 41,64"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <!-- 蓝青渐变，从左上到右下 -->
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="41"
                android:startY="33"
                android:endX="66"
                android:endY="73">
                <item android:offset="0.0" android:color="#3B9EFF" />
                <item android:offset="1.0" android:color="#22D3EE" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
